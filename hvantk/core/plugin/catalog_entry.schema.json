{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hvantk-catalog-entry",
  "title": "hvantk catalog entry",
  "type": "object",
  "required": ["accession", "title", "description", "data_source", "organism", "files"],
  "properties": {
    "accession": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "data_source": {
      "type": "string",
      "description": "Canonical source name. Closed enum, not free text: a plugin author adding a new provider's catalog entry adds its canonical name here first (one spelling per source -- no ad hoc variants, and never the placeholder 'Custom').",
      "enum": [
        "ClinGen",
        "ClinVar",
        "dbNSFP",
        "Ensembl",
        "Expression_Atlas",
        "GeVIR",
        "gnomAD",
        "GTEx",
        "GWAS Catalog",
        "INSIDER",
        "MSigDB",
        "UCSC"
      ]
    },
    "organism": { "type": "string", "minLength": 1 },
    "pubmedid": { "type": ["string", "null"] },
    "doi": { "type": "string" },
    "license": { "type": "string" },
    "update_frequency": { "type": "string" },
    "last_updated": { "type": "string" },
    "genome_build": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "format"],
        "properties": {
          "path": { "type": "string" },
          "format": { "type": "string" },
          "size_bytes": { "type": ["integer", "null"] },
          "compression": { "type": "string" },
          "url": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
