{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transcriptomics Dataset Schema",
  "description": "Schema for transcriptomics datasets extending the common schema",
  "type": "object",
  "required": ["title", "accession", "description", "files", "data_source", "expression_unit", "platform_type"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Human-readable title of the dataset"
    },
    "accession": {
      "type": "string",
      "description": "Unique identifier/accession number for the dataset",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "pubmedid": {
      "type": ["string", "null"],
      "description": "PubMed ID associated with the dataset",
      "pattern": "^[0-9]+$"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the dataset"
    },
    "files": {
      "type": "array",
      "description": "Array of file objects in the dataset",
      "items": {
        "$ref": "#/definitions/file_object"
      },
      "minItems": 1
    },
    "data_source": {
      "type": "string",
      "description": "Source of the data (e.g., GEO, TCGA, ArrayExpress)",
      "enum": ["GEO", "TCGA", "ArrayExpress", "ENA", "SRA", "dbGaP", "UCSC", "Expression_Atlas", "Custom"]
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update to the dataset metadata"
    },
    "update_frequency": {
      "type": "string",
      "description": "How frequently the dataset is expected to be updated",
      "enum": ["static", "weekly", "monthly", "quarterly", "annually", "irregular"]
    },
    "organism": {
      "type": "string",
      "description": "Scientific name of the organism",
      "default": "Homo sapiens"
    },
    "tissue_type": {
      "type": ["string", "array"],
      "description": "Tissue or cell type(s) represented in the dataset"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of samples in the dataset"
    },
    "license": {
      "type": "string",
      "description": "License or usage terms for the dataset"
    },
    "doi": {
      "type": ["string", "null"],
      "description": "Digital Object Identifier for the dataset"
    },
    "contact": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string", "format": "email"},
        "institution": {"type": "string"}
      }
    },
    "expression_unit": {
      "type": "string",
      "description": "Unit of expression measurement",
      "enum": ["TPM", "FPKM", "RPKM", "counts", "log2_counts", "CPM", "normalized_counts"]
    },
    "platform_type": {
      "type": "string",
      "description": "Technology platform used for expression profiling",
      "enum": ["RNA-seq", "microarray", "single-cell RNA-seq", "spatial transcriptomics", "bulk RNA-seq"]
    },
    "data_level": {
      "type": "string",
      "description": "Level of transcriptomic data",
      "enum": ["transcript", "gene", "exon", "junction"],
      "default": "gene"
    },
    "normalization_method": {
      "type": ["string", "null"],
      "description": "Method used for data normalization",
      "enum": ["TMM", "RLE", "quantile", "DESeq2", "edgeR", "limma", "none"]
    },
    "sequencing_depth": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Average sequencing depth per sample"
    },
    "paired_end": {
      "type": ["boolean", "null"],
      "description": "Whether sequencing was paired-end (RNA-seq only)"
    },
    "read_length": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Read length in base pairs (RNA-seq only)"
    },
    "annotation_version": {
      "type": ["string", "null"],
      "description": "Version of genome annotation used (e.g., GENCODE v40, Ensembl 108)"
    },
    "quality_metrics": {
      "type": "object",
      "properties": {
        "mapping_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Average mapping rate across samples"
        },
        "ribosomal_rna_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Average ribosomal RNA contamination rate"
        },
        "duplicate_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Average PCR duplicate rate"
        }
      }
    }
  },
  "definitions": {
    "file_object": {
      "type": "object",
      "required": ["path", "format", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative or absolute path to the file"
        },
        "format": {
          "type": "string",
          "description": "File format",
          "enum": ["tsv", "csv", "json", "parquet", "vcf", "bcf", "bam", "sam", "fastq", "fasta", "bed", "gff", "gtf", "h5", "hdf5", "xlsx", "txt", "zip", "tar.gz"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "checksum": {
          "type": "string",
          "description": "MD5 or SHA256 checksum for file integrity validation"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to download the file"
        },
        "description": {
          "type": "string",
          "description": "Description of what this file contains"
        },
        "compression": {
          "type": "string",
          "enum": ["none", "gzip", "bzip2", "xz"],
          "default": "none"
        }
      }
    }
  }
}

