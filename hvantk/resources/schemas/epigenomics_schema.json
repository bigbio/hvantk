{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epigenomics Dataset Schema",
  "description": "Schema for epigenomics datasets extending the common schema",
  "type": "object",
  "required": ["title", "accession", "description", "files", "data_source", "epigenetic_mark", "assay_type"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Human-readable title of the dataset"
    },
    "accession": {
      "type": "string",
      "description": "Unique identifier/accession number for the dataset",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "pubmedid": {
      "type": ["string", "null"],
      "description": "PubMed ID associated with the dataset",
      "pattern": "^[0-9]+$"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the dataset"
    },
    "files": {
      "type": "array",
      "description": "Array of file objects in the dataset",
      "items": {
        "$ref": "#/definitions/file_object"
      },
      "minItems": 1
    },
    "data_source": {
      "type": "string",
      "description": "Source of the data (e.g., GEO, TCGA, ArrayExpress)",
      "enum": ["GEO", "TCGA", "ArrayExpress", "ENA", "SRA", "dbGaP", "UCSC", "Expression_Atlas", "Custom"]
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update to the dataset metadata"
    },
    "update_frequency": {
      "type": "string",
      "description": "How frequently the dataset is expected to be updated",
      "enum": ["static", "weekly", "monthly", "quarterly", "annually", "irregular"]
    },
    "organism": {
      "type": "string",
      "description": "Scientific name of the organism",
      "default": "Homo sapiens"
    },
    "tissue_type": {
      "type": ["string", "array"],
      "description": "Tissue or cell type(s) represented in the dataset"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of samples in the dataset"
    },
    "license": {
      "type": "string",
      "description": "License or usage terms for the dataset"
    },
    "doi": {
      "type": ["string", "null"],
      "description": "Digital Object Identifier for the dataset"
    },
    "contact": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string", "format": "email"},
        "institution": {"type": "string"}
      }
    },
    "epigenetic_mark": {
      "type": "array",
      "description": "Epigenetic modifications measured",
      "items": {
        "type": "string",
        "enum": ["H3K4me3", "H3K27ac", "H3K4me1", "H3K27me3", "H3K36me3", "H3K9me3", "H3K79me2", "CTCF", "DNase", "ATAC", "methylation", "hydroxymethylation", "other"]
      },
      "minItems": 1
    },
    "assay_type": {
      "type": "string",
      "description": "Experimental assay used",
      "enum": ["ChIP-seq", "ATAC-seq", "DNase-seq", "FAIRE-seq", "WGBS", "RRBS", "MeDIP-seq", "hMeDIP-seq", "NOMe-seq", "CUT&RUN", "CUT&Tag"]
    },
    "resolution": {
      "type": "string",
      "description": "Spatial resolution of the data",
      "enum": ["base-pair", "bin_1kb", "bin_5kb", "bin_10kb", "bin_25kb", "bin_100kb", "peak", "region"],
      "default": "peak"
    },
    "peak_calling_algorithm": {
      "type": ["string", "null"],
      "description": "Algorithm used for peak calling",
      "enum": ["MACS2", "HOMER", "PeakSeq", "SICER", "epic2", "Genrich", "other"]
    },
    "control_type": {
      "type": ["string", "null"],
      "description": "Type of control samples used",
      "enum": ["input", "IgG", "mock", "none"]
    },
    "antibody_info": {
      "type": "object",
      "properties": {
        "target": {"type": "string"},
        "vendor": {"type": "string"},
        "catalog_number": {"type": "string"},
        "lot_number": {"type": "string"}
      }
    },
    "sequencing_info": {
      "type": "object",
      "properties": {
        "read_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequencing read length"
        },
        "paired_end": {
          "type": "boolean",
          "description": "Whether sequencing was paired-end"
        },
        "target_depth": {
          "type": "integer",
          "minimum": 1,
          "description": "Target sequencing depth per sample"
        }
      }
    },
    "methylation_context": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["CpG", "CHG", "CHH", "CpA"]
      },
      "description": "Methylation contexts measured (for methylation assays)"
    },
    "quality_metrics": {
      "type": "object",
      "properties": {
        "peak_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of peaks identified"
        },
        "frip_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of reads in peaks"
        },
        "library_complexity": {
          "type": "number",
          "minimum": 0,
          "description": "Library complexity (NRF or PBC metrics)"
        },
        "signal_to_noise": {
          "type": "number",
          "minimum": 0,
          "description": "Signal-to-noise ratio"
        }
      }
    }
  },
  "definitions": {
    "file_object": {
      "type": "object",
      "required": ["path", "format", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative or absolute path to the file"
        },
        "format": {
          "type": "string",
          "description": "File format",
          "enum": ["tsv", "csv", "json", "parquet", "vcf", "bcf", "bam", "sam", "fastq", "fasta", "bed", "gff", "gtf", "h5", "hdf5", "xlsx", "txt", "zip", "tar.gz"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "checksum": {
          "type": "string",
          "description": "MD5 or SHA256 checksum for file integrity validation"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to download the file"
        },
        "description": {
          "type": "string",
          "description": "Description of what this file contains"
        },
        "compression": {
          "type": "string",
          "enum": ["none", "gzip", "bzip2", "xz"],
          "default": "none"
        }
      }
    }
  }
}

